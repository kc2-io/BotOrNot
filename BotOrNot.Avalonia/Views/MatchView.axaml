<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BotOrNot.Avalonia.ViewModels"
             xmlns:models="using:BotOrNot.Core.Models"
             xmlns:services="using:BotOrNot.Core.Services"
             xmlns:conv="using:BotOrNot.Avalonia.Converters"
             x:Class="BotOrNot.Avalonia.Views.MatchView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <conv:BotColorConverter x:Key="BotColorConverter" />
        <conv:BotBorderColorConverter x:Key="BotBorderColorConverter" />
        <conv:PlatformNameConverter x:Key="PlatformNameConverter" />
        <conv:SquadDisplayConverter x:Key="SquadDisplayConverter" />
        <conv:UnknownToDashConverter x:Key="UnknownToDashConverter" />
    </UserControl.Resources>

    <!--
        Row layout (index: purpose):
        0  Top bar + error banner overlay
        1  Match summary bar (mode, playlist, time, stats)
        2  Filter text box
        3  Owner eliminations header
        4  Owner eliminations grid (2* height)
        5  Squad section header
        6  Squad members grid + selected teammate elimination details
        7  Players Seen header
        8  Players grid (3* height)
        9  NPCs expander (collapsed when no NPCs)
        The empty-state spans rows 2-9; the drag-over overlay spans rows 0-9.
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,2*,Auto,Auto,Auto,3*,Auto"
          DragDrop.AllowDrop="True"
          Background="Transparent">

        <!-- Top Bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8" Spacing="8">
            <Button Content="&#x2190; Library"
                    Command="{Binding BackCommand}"
                    IsVisible="{Binding HasBack}"
                    ToolTip.Tip="Back to library" />
            <Image Source="avares://BotOrNot/Assets/logo.png"
                   Width="32"
                   Height="32"
                   VerticalAlignment="Center" />
            <Button x:Name="OpenButton" Content="Select Replay File" Click="OpenReplay_Click" />
            <TextBlock Text="or drag &amp; drop"
                       TextWrapping="Wrap"
                       FontSize="12"
                       VerticalAlignment="Center" />
            <Button x:Name="ColumnsButton" Content="Columns" />
            <Button x:Name="ExportCsvButton" Content="Export to CSV" Click="ExportCsv_Click"
                    IsVisible="{Binding HasData}" />
            <Button Content="{Binding ThemeIcon}"
                    Command="{Binding CycleThemeCommand}"
                    ToolTip.Tip="{Binding ThemeToggleTooltip}"
                    Padding="6,2"
                    MinWidth="32" />
            <ProgressBar IsIndeterminate="True"
                         IsVisible="{Binding IsLoading}"
                         Width="100"
                         Height="20"
                         Margin="8,0,0,0"/>
            <TextBlock Text="Data presented is not guaranteed to be accurate."
                       Foreground="{DynamicResource SubtleTextBrush}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0" />
        </StackPanel>

        <!-- Error Banner -->
        <Border Grid.Row="0"
                Background="{DynamicResource ErrorBannerBackground}"
                BorderBrush="{DynamicResource ErrorBannerBorder}"
                BorderThickness="1"
                Padding="8"
                Margin="8,40,8,0"
                CornerRadius="4"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBannerForeground}" />
        </Border>

        <!-- Summary Header Bar -->
        <Border Grid.Row="1"
                Background="{DynamicResource SummaryBarBackground}"
                BorderBrush="{DynamicResource SummaryBarBorder}"
                BorderThickness="0,0,0,1"
                Padding="8,6"
                Margin="0"
                IsVisible="{Binding HasMetadata}"
                ToolTip.Tip="{Binding PlaylistName}">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Mode -->
                <Border Background="{DynamicResource PillBackground}" CornerRadius="4" Padding="8,3" Margin="0,2,6,2">
                    <TextBlock Text="{Binding GameMode}" FontSize="12" VerticalAlignment="Center"
                               MaxWidth="300" TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- Matchmaking region -->
                <Border Background="{DynamicResource PillBackground}" CornerRadius="4" Padding="8,3" Margin="0,2,6,2">
                    <TextBlock Text="{Binding MatchmakingRegionDisplay}" FontSize="12" VerticalAlignment="Center" />
                </Border>

                <!-- Placement -->
                <Border Background="{DynamicResource PillBackground}" CornerRadius="4" Padding="8,3" Margin="0,2,6,2">
                    <TextBlock Text="{Binding PlacementText}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                </Border>

                <!-- Duration -->
                <Border Background="{DynamicResource PillBackground}" CornerRadius="4" Padding="8,3" Margin="0,2,6,2">
                    <TextBlock Text="{Binding DurationText}" FontSize="12" VerticalAlignment="Center" />
                </Border>

                <!-- Elims Summary -->
                <Border Background="{DynamicResource PillBackground}" CornerRadius="4" Padding="8,3" Margin="0,2,6,2">
                    <TextBlock Text="{Binding ElimsSummary}" FontSize="12" VerticalAlignment="Center" />
                </Border>

                <!-- Eliminated by (conditional) -->
                <Border Background="{DynamicResource PillBackground}" CornerRadius="4" Padding="8,3" Margin="0,2,6,2"
                        IsVisible="{Binding EliminatorName, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Eliminated by:" FontSize="12" VerticalAlignment="Center" />
                        <Button Content="{Binding EliminatorName}"
                                Command="{Binding FilterByPlayerCommand}"
                                CommandParameter="{Binding EliminatorName}"
                                Padding="2,0"
                                FontSize="12"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource LinkForeground}"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Foreground" Value="{DynamicResource LinkHoverForeground}" />
                                </Style>
                            </Button.Styles>
                        </Button>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>

        <!-- Filter Box -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,8,8,4" Spacing="8"
                    IsVisible="{Binding HasData}">
            <TextBlock Text="Filter:" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBox Text="{Binding FilterText}"
                     Watermark="Type to filter results..."
                     Width="400"
                     Height="30" />
        </StackPanel>

        <!-- Owner Eliminations Header -->
        <StackPanel Grid.Row="3" Margin="8,8,8,4" IsVisible="{Binding HasData}">
            <TextBlock Text="{Binding OwnerKillsHeader}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
            <TextBlock Text="{Binding EliminationCoverageNotice}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       IsVisible="{Binding HasEliminationCoverageNotice}" />
        </StackPanel>

        <!-- Owner Eliminations Grid -->
        <DataGrid Grid.Row="4"
                  x:Name="OwnerEliminationsGrid"
                  ItemsSource="{Binding OwnerEliminations}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  Margin="8,0,8,8"
                  IsVisible="{Binding HasData}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="364" IsVisible="False" />
                <DataGridTemplateColumn Header="Name" Width="195" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:PlayerRow">
                            <Panel>
                                <Button Content="{Binding Name}"
                                        Click="OpenFortniteTracker_Click"
                                        IsVisible="{Binding !IsBot}"
                                        Padding="4,2"
                                        FontSize="12"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource LinkForeground}"
                                        Cursor="Hand"
                                        ToolTip.Tip="Click to check if this player has a Fortnite Tracker page">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Foreground" Value="{DynamicResource LinkHoverForeground}" />
                                        </Style>
                                    </Button.Styles>
                                </Button>
                                <TextBlock Text="{Binding Name}"
                                           IsVisible="{Binding IsBot}"
                                           VerticalAlignment="Center"
                                           Margin="4,0" />
                            </Panel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Level" Binding="{Binding Level, Converter={StaticResource UnknownToDashConverter}}" Width="104" />
                <DataGridTemplateColumn Header="Bot" Width="78" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:PlayerRow">
                            <Ellipse Width="14" Height="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{Binding Bot, Converter={StaticResource BotColorConverter}}"
                                     Stroke="{Binding Bot, Converter={StaticResource BotBorderColorConverter}}"
                                     StrokeThickness="1.5" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Platform" Binding="{Binding Platform, Converter={StaticResource PlatformNameConverter}}" Width="130" />
                <DataGridTextColumn Header="Kills" Binding="{Binding Kills, Converter={StaticResource UnknownToDashConverter}}" Width="91" />
                <DataGridTextColumn Header="Squad" Binding="{Binding TeamIndex, Converter={StaticResource SquadDisplayConverter}}" Width="100" />
                <DataGridTextColumn Header="Squad Size" Binding="{Binding SquadSize}" Width="90" />
                <DataGridTextColumn Header="Place" Binding="{Binding Placement, Converter={StaticResource UnknownToDashConverter}}" Width="90" />
                <DataGridTemplateColumn Header="Death Cause" Width="156" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:PlayerRow">
                            <TextBlock Text="{Binding DeathCause}" Margin="12,0,8,0" VerticalAlignment="Center">
                                <ToolTip.Tip>
                                    <ScrollViewer MaxWidth="560" MaxHeight="400">
                                        <TextBlock Text="{Binding DeathCauseInfo.EvidenceSummary}" TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </ToolTip.Tip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Elim Time" Binding="{Binding ElimTime}" Width="90" />
                <DataGridTemplateColumn Header="Storm Phase" Width="110" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:PlayerRow">
                            <TextBlock Text="{Binding StormPhaseDisplay}"
                                       Margin="12,0,8,0" VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding StormPhaseTooltip}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Pickaxe" Binding="{Binding Pickaxe}" Width="195" IsVisible="False" />
                <DataGridTextColumn Header="Glider" Binding="{Binding Glider}" Width="195" IsVisible="False" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Squad section is deliberately independent of the player search. -->
        <StackPanel Grid.Row="5"
                    Margin="8,8,8,4"
                    Spacing="2"
                    IsVisible="{Binding HasSquadSection}">
            <TextBlock Text="Squad" FontWeight="Bold" FontSize="14" />
            <TextBlock Text="{Binding SquadStatusText}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="6"
                    IsVisible="{Binding HasSquadMembers}">
        <DataGrid x:Name="SquadGrid"
                  MaxHeight="200"
                  ItemsSource="{Binding Teammates}"
                  SelectedItem="{Binding SelectedTeammate, Mode=OneWay}"
                  SelectionMode="Single"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  Margin="8,0,8,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding StableId}" Width="220" IsVisible="False" />
                <DataGridTemplateColumn Header="Name" Width="195" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="services:SquadMemberSummary">
                            <Panel>
                                <Button Content="{Binding Name, Converter={StaticResource UnknownToDashConverter}}"
                                        Click="OpenFortniteTracker_Click"
                                        IsVisible="{Binding CanOpenFortniteTracker}"
                                        Padding="4,2"
                                        FontSize="12"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource LinkForeground}"
                                        Cursor="Hand"
                                        ToolTip.Tip="Click to check if this player has a Fortnite Tracker page">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Foreground" Value="{DynamicResource LinkHoverForeground}" />
                                        </Style>
                                    </Button.Styles>
                                </Button>
                                <TextBlock Text="{Binding Name, Converter={StaticResource UnknownToDashConverter}}"
                                           IsVisible="{Binding !CanOpenFortniteTracker}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Name}"
                                           VerticalAlignment="Center"
                                           Margin="4,0" />
                            </Panel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80" />
                <DataGridTextColumn Header="Platform" Binding="{Binding Platform, Converter={StaticResource PlatformNameConverter}}" Width="120" />
                <DataGridTextColumn Header="Kills" Binding="{Binding Kills}" Width="75" />
                <DataGridTextColumn Header="Players Observed" Binding="{Binding ObservedPlayerKills}" Width="125" />
                <DataGridTextColumn Header="Bots Observed" Binding="{Binding ObservedBotKills}" Width="110" />
                <DataGridTextColumn Header="Unknown Observed" Binding="{Binding ObservedUnknownKills}" Width="130" />
                <DataGridTemplateColumn Header="Death Cause" Width="156" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="services:SquadMemberSummary">
                            <TextBlock Text="{Binding DeathCause, Converter={StaticResource UnknownToDashConverter}}"
                                       Margin="12,0,8,0"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding DeathCauseInfo.EvidenceSummary}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Place" Binding="{Binding Placement}" Width="75" />
                <DataGridTextColumn Header="Observed" Binding="{Binding ObservedSquadSize}" Width="95" />
            </DataGrid.Columns>
        </DataGrid>

        <Expander Margin="8,0,8,8"
                  IsExpanded="False"
                  IsVisible="{Binding HasSelectedTeammate}">
            <Expander.Header>
                <TextBlock Text="{Binding TeammateEliminationsHeader}"
                           FontWeight="Bold"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </Expander.Header>
            <StackPanel Spacing="2">
            <TextBlock Text="{Binding TeammateEliminationCoverageNotice}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       IsVisible="{Binding TeammateEliminationCoverageNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <DataGrid x:Name="TeammateEliminationsGrid"
                      MaxHeight="180"
                      ItemsSource="{Binding TeammateEliminations}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal"
                      Margin="0,2,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="195" />
                    <DataGridTemplateColumn Header="Bot" Width="78" CanUserSort="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:PlayerRow">
                                <Ellipse Width="14" Height="14"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Fill="{Binding Bot, Converter={StaticResource BotColorConverter}}"
                                         Stroke="{Binding Bot, Converter={StaticResource BotBorderColorConverter}}"
                                         StrokeThickness="1.5" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Platform" Binding="{Binding Platform, Converter={StaticResource PlatformNameConverter}}" Width="130" />
                    <DataGridTemplateColumn Header="Death Cause" Width="156" CanUserSort="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:PlayerRow">
                                <TextBlock Text="{Binding DeathCause}" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <ToolTip.Tip>
                                        <ScrollViewer MaxWidth="560" MaxHeight="400">
                                            <TextBlock Text="{Binding DeathCauseInfo.EvidenceSummary}" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </ToolTip.Tip>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Elim Time" Binding="{Binding ElimTime}" Width="90" />
                    <DataGridTemplateColumn Header="Storm Phase" Width="110" CanUserSort="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:PlayerRow">
                                <TextBlock Text="{Binding StormPhaseDisplay}"
                                           Margin="12,0,8,0"
                                           VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding StormPhaseTooltip}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            </StackPanel>
        </Expander>
        </StackPanel>

        <!-- Players Seen Header -->
        <TextBlock Grid.Row="7"
                   Text="{Binding PlayersSeenHeader}"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="8,8,8,4"
                   IsVisible="{Binding HasData}" />

        <!-- All Players Grid -->
        <DataGrid Grid.Row="8"
                  x:Name="PlayersGrid"
                  ItemsSource="{Binding Players}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  Margin="8,0,8,8"
                  IsVisible="{Binding HasData}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="364" IsVisible="False" />
                <DataGridTemplateColumn Header="Name" Width="195" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:PlayerRow">
                            <Panel>
                                <Button Content="{Binding Name}"
                                        Click="OpenFortniteTracker_Click"
                                        IsVisible="{Binding !IsBot}"
                                        Padding="4,2"
                                        FontSize="12"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource LinkForeground}"
                                        Cursor="Hand"
                                        ToolTip.Tip="Click to check if this player has a Fortnite Tracker page">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Foreground" Value="{DynamicResource LinkHoverForeground}" />
                                        </Style>
                                    </Button.Styles>
                                </Button>
                                <TextBlock Text="{Binding Name}"
                                           IsVisible="{Binding IsBot}"
                                           VerticalAlignment="Center"
                                           Margin="4,0" />
                            </Panel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Level" Binding="{Binding Level, Converter={StaticResource UnknownToDashConverter}}" Width="104" />
                <DataGridTemplateColumn Header="Bot" Width="78" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:PlayerRow">
                            <Ellipse Width="14" Height="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{Binding Bot, Converter={StaticResource BotColorConverter}}"
                                     Stroke="{Binding Bot, Converter={StaticResource BotBorderColorConverter}}"
                                     StrokeThickness="1.5" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Platform" Binding="{Binding Platform, Converter={StaticResource PlatformNameConverter}}" Width="130" />
                <DataGridTextColumn Header="Kills" Binding="{Binding Kills, Converter={StaticResource UnknownToDashConverter}}" Width="91" />
                <DataGridTextColumn Header="Squad" Binding="{Binding TeamIndex, Converter={StaticResource SquadDisplayConverter}}" Width="100" />
                <DataGridTextColumn Header="Squad Size" Binding="{Binding SquadSize}" Width="90" />
                <DataGridTextColumn Header="Place" Binding="{Binding Placement, Converter={StaticResource UnknownToDashConverter}}" Width="90" />
                <DataGridTemplateColumn Header="Death Cause" Width="156" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:PlayerRow">
                            <TextBlock Text="{Binding DeathCause}" Margin="12,0,8,0" VerticalAlignment="Center">
                                <ToolTip.Tip>
                                    <ScrollViewer MaxWidth="560" MaxHeight="400">
                                        <TextBlock Text="{Binding DeathCauseInfo.EvidenceSummary}" TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </ToolTip.Tip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Elim Time" Binding="{Binding ElimTime}" Width="90" />
                <DataGridTemplateColumn Header="Storm Phase" Width="110" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:PlayerRow">
                            <TextBlock Text="{Binding StormPhaseDisplay}"
                                       Margin="12,0,8,0" VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding StormPhaseTooltip}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Pickaxe" Binding="{Binding Pickaxe}" Width="195" IsVisible="False" />
                <DataGridTextColumn Header="Glider" Binding="{Binding Glider}" Width="195" IsVisible="False" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- NPCs Expander -->
        <Expander Grid.Row="9"
                  Margin="8,8,8,4"
                  IsExpanded="False"
                  IsVisible="{Binding HasNpcs}">
            <Expander.Header>
                <TextBlock Text="{Binding NpcsSeenHeader}"
                           FontWeight="Bold"
                           FontSize="14" />
            </Expander.Header>
            <DataGrid x:Name="NpcsGrid"
                      ItemsSource="{Binding Npcs}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal"
                      Margin="0,4,0,0"
                      Height="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="364" IsVisible="False" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="195" />
                    <DataGridTextColumn Header="Death Cause" Binding="{Binding DeathCause}" Width="156" />
                    <DataGridCheckBoxColumn Header="Killed by You" Binding="{Binding KilledByOwner}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </Expander>

        <!-- Empty-state drop zone (visible when no data loaded) -->
        <Border Grid.Row="2" Grid.RowSpan="8"
                IsVisible="{Binding !HasData}"
                Background="Transparent"
                Margin="8">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <TextBlock Text="&#x1F4C1;"
                           FontSize="48"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource EmptyStateIconBrush}" />
                <TextBlock Text="Drop a .replay file here"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource EmptyStatePrimaryBrush}" />
                <TextBlock Text="or click Select Replay File"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource EmptyStateSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Drag-over overlay -->
        <Border Grid.Row="0" Grid.RowSpan="10"
                IsVisible="{Binding IsDropTargetActive}"
                Background="{DynamicResource DragOverlayBackground}"
                BorderBrush="{DynamicResource DragOverlayBorder}"
                BorderThickness="3"
                CornerRadius="8"
                IsHitTestVisible="False">
            <TextBlock Text="Drop .replay file"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource DragOverlayText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
