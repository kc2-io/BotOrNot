+using System.Collections.Generic;
+using Unreal.Core.Attributes;
+using Unreal.Core.Contracts;
+using Unreal.Core.Models;
+using Unreal.Core.Models.Enums;
+using Unreal.Core.Test.Mocks;
+using Xunit;
+
+namespace Unreal.Core.Test;
+
+[NetFieldExportGroup("policy-group", minimalParseMode: ParseMode.Minimal)]
+public class PolicyGroup : INetFieldExportGroup
+{
+    [NetFieldExport("First", RepLayoutCmdType.PropertyBool)]
+    public bool First { get; set; }
+
+    [NetFieldExport("Second", RepLayoutCmdType.PropertyBool)]
+    public bool Second { get; set; }
+}
+
+public class ReplayReadPolicyTest
+{
+    [Fact]
+    public void RejectedGroupConsumesNetDeltaFieldsWithoutIgnoringChannel()
+    {
+        var reader = new FilteringReplayReader(readGroup: false, rejectedField: null);
+        var group = CreateGroup();
+        var archive = CreatePropertiesArchive();
+
+        var result = reader.ReceiveProperties(
+            archive, group, 1, out var exportGroup,
+            enablePropertyChecksum: false, netDeltaUpdate: true);
+
+        Assert.True(result);
+        Assert.True(archive.AtEnd());
+        Assert.False(archive.IsError);
+        Assert.Null(exportGroup);
+        Assert.Null(reader.LastExport);
+        Assert.False(reader.IsIgnoringGroup(1, group.PathName));
+    }
+
+    [Fact]
+    public void DefaultPolicyPreservesExportForEmptyUpdate()
+    {
+        var reader = new FilteringReplayReader(readGroup: true, rejectedField: null);
+        var group = CreateGroup();
+        var archive = CreateEmptyPropertiesArchive();
+
+        var result = reader.ReceiveProperties(
+            archive, group, 1, out var exportGroup, enablePropertyChecksum: false);
+
+        Assert.True(result);
+        Assert.True(archive.AtEnd());
+        Assert.False(archive.IsError);
+        Assert.IsType<PolicyGroup>(exportGroup);
+        Assert.Null(reader.LastExport);
+    }
+
+    [Fact]
+    public void RejectedFieldIsSkippedBeforeFollowingFieldIsDecoded()
+    {
+        var reader = new FilteringReplayReader(readGroup: true, rejectedField: "First");
+        var group = CreateGroup();
+        var archive = CreatePropertiesArchive();
+
+        var result = reader.ReceiveProperties(
+            archive, group, 1, out var exportGroup, enablePropertyChecksum: false);
+
+        Assert.True(result);
+        Assert.True(archive.AtEnd());
+        Assert.False(archive.IsError);
+        var parsed = Assert.IsType<PolicyGroup>(exportGroup);
+        Assert.False(parsed.First);
+        Assert.True(parsed.Second);
+        Assert.Same(parsed, reader.LastExport);
+        Assert.False(group.NetFieldExports[0]!.Incompatible);
+    }
+
+    private static NetFieldExportGroup CreateGroup() => new()
+    {
+        PathName = "policy-group",
+        NetFieldExportsLength = 2,
+        NetFieldExports = new NetFieldExport?[]
+        {
+            new() { Handle = 0, Name = "First" },
+            new() { Handle = 1, Name = "Second" },
+        },
+    };
+
+    private static NetBitReader CreatePropertiesArchive()
+    {
+        var bits = new List<bool>();
+        WritePacked(bits, 1); // First field handle + 1.
+        WritePacked(bits, 1); // One payload bit.
+        bits.Add(true);
+        WritePacked(bits, 2); // Second field handle + 1.
+        WritePacked(bits, 1); // One payload bit.
+        bits.Add(true);
+        WritePacked(bits, 0); // End of properties.
+
+        var bytes = new byte[(bits.Count + 7) / 8];
+        for (var index = 0; index < bits.Count; index++)
+        {
+            if (bits[index])
+                bytes[index / 8] |= (byte)(1 << (index & 7));
+        }
+
+        return new NetBitReader(bytes, bits.Count);
+    }
+
+    private static NetBitReader CreateEmptyPropertiesArchive()
+    {
+        var bits = new List<bool>();
+        WritePacked(bits, 0);
+        return new NetBitReader(new byte[] { 0 }, bits.Count);
+    }
+
+    private static void WritePacked(List<bool> bits, uint value)
+    {
+        do
+        {
+            var chunk = (byte)((value & 0x7f) << 1);
+            value >>= 7;
+            if (value != 0)
+                chunk |= 1;
+            for (var bit = 0; bit < 8; bit++)
+                bits.Add((chunk & (1 << bit)) != 0);
+        } while (value != 0);
+    }
+
+    private sealed class FilteringReplayReader : ReplayReader<MockReplay>
+    {
+        private readonly bool _readGroup;
+        private readonly string? _rejectedField;
+
+        public FilteringReplayReader(bool readGroup, string? rejectedField)
+            : base(logger: null, ParseMode.Minimal)
+        {
+            _readGroup = readGroup;
+            _rejectedField = rejectedField;
+            Channels[1] = new UChannel { ChannelIndex = 1 };
+        }
+
+        public INetFieldExportGroup? LastExport { get; private set; }
+
+        public bool IsIgnoringGroup(uint channelIndex, string group) =>
+            Channels[channelIndex]!.IsIgnoringGroup(group);
+
+        protected override bool ShouldReadGroup(NetFieldExportGroup group) => _readGroup;
+
+        protected override bool ShouldReadField(NetFieldExportGroup group, NetFieldExport field) =>
+            !string.Equals(field.Name, _rejectedField, StringComparison.Ordinal);
+
+        protected override void OnExportRead(uint channelIndex, INetFieldExportGroup? exportGroup) =>
+            LastExport = exportGroup;
+
+        protected override void OnExternalDataRead(uint channelIndex, IExternalData? update)
+        {
+        }
+
+        protected override void OnNetDeltaRead(uint channelIndex, NetDeltaUpdate update)
+        {
+        }
+    }
+}
